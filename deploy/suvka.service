# Runs the Next server and brings it back if it dies. Install with:
#
#   sudo cp deploy/suvka.service /etc/systemd/system/suvka.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now suvka

[Unit]
Description=Suvka
After=network.target postgresql.service

# DESISTIR É O COMPORTAMENTO CERTO QUANDO A CONFIGURAÇÃO ESTÁ ERRADA.
#
# O instrumentation.ts sai com código 1 quando falta uma variável obrigatória. Com
# Restart=always e sem estes dois limites, isso era um ciclo infinito: reiniciar de três em
# três segundos, para sempre, a encher o journal e a esconder a mensagem que explica o que
# falta. Cinco tentativas em sessenta segundos e a unidade fica `failed`, com a última linha
# do erro à vista num `systemctl status suvka`.
#
# Uma falha transitória - o Postgres a arrancar devagar, um OOM - continua a ser recuperada
# pelo Restart=always, porque essa recupera dentro das cinco.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=suvka
WorkingDirectory=/srv/suvka

# Secrets live in a file readable only by the service user, never in this unit and never
# in the repository. See deploy/README.md.
EnvironmentFile=/srv/suvka/.env.production

Environment=NODE_ENV=production
Environment=PORT=3000

ExecStart=/usr/bin/npm run start

Restart=always
RestartSec=3

# UMA MÁQUINA, DE PROPÓSITO - E A RAZÃO MUDOU.
#
# Os rascunhos viviam em memória, e por isso um segundo worker devolvia 404 a quem tinha
# gerado o site no primeiro. Isso já não é verdade: são linhas em Postgres e sobrevivem a
# reinícios e a workers.
#
# O que ainda prende isto a uma máquina são as FOTOGRAFIAS EM DISCO (SUVKA_UPLOADS_DIR).
# Uma segunda máquina não vê os uploads da primeira, e o prato de um cliente daria 404 a
# metade dos visitantes. Antes de escalar: mover para armazenamento de objetos e definir
# UPSTASH_REDIS_REST_URL/_TOKEN para os limites de pedidos deixarem de ser por processo.

StandardOutput=journal
StandardError=journal
SyslogIdentifier=suvka

[Install]
WantedBy=multi-user.target
