# Caddy handles TLS on its own - certificates are issued and renewed from Let's Encrypt
# with no cron job and no certbot. Replace the domain and the email, and that is the whole
# HTTPS story.
#
# Put this at /etc/caddy/Caddyfile and run: sudo systemctl reload caddy

{
	# Where Let's Encrypt sends expiry warnings. A real address you read.
	email SEU-EMAIL@exemplo.pt
}

noctra.pt, www.noctra.pt {
	encode zstd gzip

	# Uploaded photographs are served straight off disk by Caddy rather than through
	# Node. They never change once written, so they are cached hard - a restaurant's own
	# dish photo is the largest thing on their page and it should be fetched once.
	# Fora do repositório, de propósito: se vivessem em /srv/noctra/public, um checkout
	# limpo ou um `git clean` apagava as fotografias que os restaurantes tiraram à comida
	# deles - a única coisa aqui que não se gera outra vez.
	#
	# Tem de coincidir com NOCTRA_UPLOADS_DIR no .env.production. Se mudar um, mude o outro.
	handle_path /uploads/* {
		root * /srv/noctra-uploads
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}

	# Published restaurant sites are the product. If Node is down, say so plainly rather
	# than showing a Caddy default page on somebody's business address.
	handle_errors {
		respond "O site está temporariamente indisponível. Tente daqui a pouco." 503
	}

	log {
		output file /var/log/caddy/noctra.log
		format json
	}
}
