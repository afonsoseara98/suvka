# Copiar para /srv/suvka/.env.production, preencher, e depois:
#
#   chmod 600 /srv/suvka/.env.production
#   chown suvka:suvka /srv/suvka/.env.production
#
# Este ficheiro é lido pelo systemd (ver suvka.service). Nada aqui vai para o git -
# .gitignore cobre .env* - e este exemplo nunca deve conter um valor real.

# ─── OBRIGATÓRIO: sem isto o produto não arranca ──────────────────────────────

# Postgres na mesma máquina. A password é a que definiu no `createuser --pwprompt`.
DATABASE_URL="postgresql://suvka:PASSWORD-DA-BASE-DE-DADOS@localhost:5432/suvka?schema=public"

# Assina os cookies de sessão. Gere um novo - NUNCA reutilize o de desenvolvimento, porque
# quem o tiver consegue forjar uma sessão para qualquer conta:
#   openssl rand -base64 32
AUTH_SECRET="COLE-AQUI-O-RESULTADO-DO-OPENSSL"

# O endereço público. Usado para construir URLs absolutos e validar callbacks de login.
#
# Os três têm de ser o MESMO domínio - o arranque recusa-se a continuar se APP_URL e
# AUTH_URL discordarem. É de APP_URL que saem as URLs absolutas do /sitemap.xml e a linha
# Sitemap: do /robots.txt; sem ela, o sitemap sairia com endereços localhost, responderia
# 200, e nenhum site de restaurante era indexado.
APP_URL="https://SEU-DOMINIO.pt"
AUTH_URL="https://SEU-DOMINIO.pt"
NEXTAUTH_URL="https://SEU-DOMINIO.pt"

# ─── ENVIO DE EMAIL ──────────────────────────────────────────────────────────

# Sem isto, um dono de restaurante que se esqueça da palavra-passe fica sem forma de
# voltar a entrar sozinho - o /recuperar responde 503 e ele tem de nos contactar. O
# arranque avisa mas não morre; com uma das duas preenchida e a outra não, morre, porque
# metade da configuração de envio não envia nada e parece feita.
RESEND_API_KEY="re_..."
MAIL_FROM="Suvka <ola@SEU-DOMINIO.pt>"

# Para onde vão os alertas quando alguma coisa falha: um pagamento que o webhook não
# reconheceu, uma publicação que não passou, um site que não se gerou. Sem isto, uma falha
# em produção vai para o journal e fica lá - e ninguém lê um journal por iniciativa própria.
#
# Repetições da mesma falha nos 15 minutos seguintes não são enviadas.
ALERT_EMAIL="voce@exemplo.pt"

# ─── FOTOGRAFIAS DOS CLIENTES ─────────────────────────────────────────────────

# Fora do repositório, de propósito. Se ficasse em /srv/suvka/public/uploads, um checkout
# limpo ou um `git clean` apagava as fotografias que os restaurantes tiraram à comida deles
# - a única coisa neste produto que não se consegue gerar outra vez.
#
# O Caddyfile serve este mesmo caminho em /uploads/*. Se mudar um, mude o outro.
SUVKA_UPLOADS_DIR="/srv/suvka-uploads"

# ─── PAGAMENTOS ───────────────────────────────────────────────────────────────

# Sem estas, o produto corre exatamente na mesma e o painel simplesmente não mostra botão
# de subscrição. Um checkout que rebenta é pior do que não existir.
#
# Em produção são chaves `live`, e o Price tem de ser criado no modo live - um price_ de
# teste não existe em live e o checkout falha.
STRIPE_SECRET_KEY="sk_live_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."
STRIPE_PRICE_ID="price_..."

# Do painel do Stripe → Developers → Webhooks → o endpoint que criou.
# Sem isto o webhook recusa TODOS os pedidos, de propósito: é público por necessidade e,
# sem assinatura verificada, quem souber o URL marca qualquer cliente como pagante.
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── FOTOGRAFIAS DE BANCO ─────────────────────────────────────────────────────

# Sem isto os sites gerados saem sem imagens. Funciona, mas parece um rascunho.
PEXELS_API_KEY="..."

# ─── OPCIONAL ─────────────────────────────────────────────────────────────────

# Só o fluxo de texto livre (/api/generate) usa isto. O fluxo dos restaurantes - que é o
# produto - não faz uma única chamada a um modelo.
# OPENAI_API_KEY="..."

# Limites de pedidos partilhados entre processos. Numa máquina só, com um processo, o
# limitador em memória chega. Passa a ser necessário no dia em que houver duas máquinas.
# UPSTASH_REDIS_REST_URL="..."
# UPSTASH_REDIS_REST_TOKEN="..."

# Quem pode abrir as rotas internas de benchmark, que fazem chamadas pagas a modelos.
# Vazio significa NINGUEM - falha fechado, que e o lado seguro para errar aqui.
# Varios separados por virgula.
ADMIN_EMAILS=""
